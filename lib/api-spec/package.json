  "private": true,
  "scripts": {
    "codegen": "orval --config ./orval.config.ts && node -e \"const fs=require('fs'),path=require('path');const files=['../../lib/api-zod/src/generated/api.ts'];files.forEach(f=>{const p=path.resolve(__dirname,f);if(fs.existsSync(p)){fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/zod\\.int\\(\\)/g,'zod.number()'))}})\" && pnpm -w run typecheck:libs"
